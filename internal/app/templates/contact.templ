package templates

// ContactFormTexts holds the localized form labels and messages.
type ContactFormTexts struct {
	Heading      string
	NameLabel    string
	EmailLabel   string
	SubjectLabel string
	MessageLabel string
	SubmitText   string
	SuccessMsg   string
	SuccessRefMsg string
	ErrorMsg     string
	RequiredMsg  string
}

// DefaultContactTexts returns default texts for the given language.
func DefaultContactTexts(lang string) ContactFormTexts {
	if lang == "en" {
		return ContactFormTexts{
			Heading:      "Contact",
			NameLabel:    "Name",
			EmailLabel:   "Email",
			SubjectLabel: "Subject",
			MessageLabel: "Message",
			SubmitText:   "Send message",
			SuccessMsg:   "Thank you! Your message has been sent.",
			SuccessRefMsg: "Your reference number:",
			ErrorMsg:     "An error occurred. Please try again.",
			RequiredMsg:  "Please fill in all required fields.",
		}
	}
	return ContactFormTexts{
		Heading:      "Kontakt",
		NameLabel:    "Name",
		EmailLabel:   "E-Mail",
		SubjectLabel: "Betreff",
		MessageLabel: "Nachricht",
		SubmitText:   "Nachricht senden",
		SuccessMsg:   "Vielen Dank! Ihre Nachricht wurde gesendet.",
		SuccessRefMsg: "Ihre Referenznummer:",
		ErrorMsg:     "Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut.",
		RequiredMsg:  "Bitte füllen Sie alle Pflichtfelder aus.",
	}
}

// ContactForm renders the contact form with honeypot field.
templ ContactForm(texts ContactFormTexts) {
	<section class="contact-form-section" aria-label={ texts.Heading }>
		<div class="contact-form-inner">
			<h2 class="contact-form-heading">{ texts.Heading }</h2>

			// Success message (hidden by default, shown by JS)
			<div id="contact-success" class="form-message form-success" hidden aria-live="polite">
				<p>{ texts.SuccessMsg }</p>
				<p style="display: none; margin-top: 0.5rem;">
					<strong>{ texts.SuccessRefMsg }</strong>
					<code class="contact-ref" style="background: #f0f0f0; padding: 2px 6px; border-radius: 3px; font-family: monospace;"></code>
				</p>
			</div>

			// Error message (hidden by default, shown by JS)
			<div id="contact-error" class="form-message form-error" hidden aria-live="polite">
				<p>{ texts.ErrorMsg }</p>
			</div>

			<form
				id="contact-form"
				class="contact-form"
				method="POST"
				action="/api/contact"
				novalidate
			>
				// Honeypot (hidden, bots fill it in)
				<div class="form-field form-honeypot" aria-hidden="true" tabindex="-1">
					<label for="website">Website</label>
					<input type="text" id="website" name="website" autocomplete="off" tabindex="-1"/>
				</div>

				// Name
				<div class="form-field">
					<label for="contact-name" class="form-label">
						{ texts.NameLabel }
						<span class="form-required" aria-label="required">*</span>
					</label>
					<input
						type="text"
						id="contact-name"
						name="name"
						class="form-input"
						required
						autocomplete="name"
					/>
				</div>

				// Email
				<div class="form-field">
					<label for="contact-email" class="form-label">
						{ texts.EmailLabel }
						<span class="form-required" aria-label="required">*</span>
					</label>
					<input
						type="email"
						id="contact-email"
						name="email"
						class="form-input"
						required
						autocomplete="email"
					/>
				</div>

				// Subject
				<div class="form-field">
					<label for="contact-subject" class="form-label">
						{ texts.SubjectLabel }
						<span class="form-required" aria-label="required">*</span>
					</label>
					<input
						type="text"
						id="contact-subject"
						name="subject"
						class="form-input"
						required
					/>
				</div>

				// Message
				<div class="form-field">
					<label for="contact-message" class="form-label">
						{ texts.MessageLabel }
						<span class="form-required" aria-label="required">*</span>
					</label>
					<textarea
						id="contact-message"
						name="message"
						class="form-textarea"
						rows="6"
						required
					></textarea>
				</div>

				// Submit
				<div class="form-actions">
					<button type="submit" class="form-submit" id="contact-submit">
						{ texts.SubmitText }
					</button>
				</div>
			</form>
		</div>
	</section>
}
