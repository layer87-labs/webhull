package templates

import "github.com/layer87-labs/webhull/internal/pkg/config"

// fieldInputType maps a FieldConfig type to a safe HTML input type.
func fieldInputType(t string) string {
	switch t {
	case "email", "tel":
		return t
	default:
		return "text"
	}
}

// ContactFormTexts holds the localized form labels and messages.
type ContactFormTexts struct {
	Heading       string
	SubmitText    string
	SuccessMsg    string
	SuccessRefMsg string
	ErrorMsg      string
	// Fields is the ordered list of form fields to render.
	// When empty the template falls back to DefaultFields.
	Fields []config.FieldConfig
}

// DefaultFields returns the built-in 4-field form for the given language.
func DefaultFields(lang string) []config.FieldConfig {
	if lang == "en" {
		return []config.FieldConfig{
			{Name: "name", Label: "Name", Type: "text", Required: true},
			{Name: "email", Label: "Email", Type: "email", Required: true},
			{Name: "subject", Label: "Subject", Type: "text", Required: true},
			{Name: "message", Label: "Message", Type: "textarea", Required: true},
		}
	}
	return []config.FieldConfig{
		{Name: "name", Label: "Name", Type: "text", Required: true},
		{Name: "email", Label: "E-Mail", Type: "email", Required: true},
		{Name: "subject", Label: "Betreff", Type: "text", Required: true},
		{Name: "message", Label: "Nachricht", Type: "textarea", Required: true},
	}
}

// DefaultContactTexts returns default UI strings for the given language.
func DefaultContactTexts(lang string) ContactFormTexts {
	if lang == "en" {
		return ContactFormTexts{
			Heading:       "Contact",
			SubmitText:    "Send message",
			SuccessMsg:    "Thank you! Your message has been sent.",
			SuccessRefMsg: "Your reference number:",
			ErrorMsg:      "An error occurred. Please try again.",
			Fields:        DefaultFields(lang),
		}
	}
	return ContactFormTexts{
		Heading:       "Kontakt",
		SubmitText:    "Nachricht senden",
		SuccessMsg:    "Vielen Dank! Ihre Nachricht wurde gesendet.",
		SuccessRefMsg: "Ihre Referenznummer:",
		ErrorMsg:      "Ein Fehler ist aufgetreten. Bitte versuchen Sie es erneut.",
		Fields:        DefaultFields(lang),
	}
}

// ContactForm renders a fully dynamic contact form driven by texts.Fields.
templ ContactForm(texts ContactFormTexts) {
	<section class="contact-form-section" aria-label={ texts.Heading }>
		<div class="contact-form-inner">
			if texts.Heading != "" {
				<h2 class="contact-form-heading">{ texts.Heading }</h2>
			}

			<div id="contact-success" class="form-message form-success" hidden aria-live="polite">
				<p>{ texts.SuccessMsg }</p>
				<p style="display: none; margin-top: 0.5rem;">
					<strong>{ texts.SuccessRefMsg }</strong>
					<code class="contact-ref" style="background: #f0f0f0; padding: 2px 6px; border-radius: 3px; font-family: monospace;"></code>
				</p>
			</div>

			<div id="contact-error" class="form-message form-error" hidden aria-live="polite">
				<p>{ texts.ErrorMsg }</p>
			</div>

			<form id="contact-form" class="contact-form" method="POST" action="/api/contact" novalidate>
				// Honeypot (hidden, bots fill it in)
				<div class="form-field form-honeypot" aria-hidden="true" tabindex="-1">
					<label for="website">Website</label>
					<input type="text" id="website" name="website" autocomplete="off" tabindex="-1"/>
				</div>

				// Dynamic fields
				for _, f := range texts.Fields {
					<div class="form-field">
						<label for={ "contact-" + f.Name } class="form-label">
							{ f.Label }
							if f.Required {
								<span class="form-required" aria-label="required">*</span>
							}
						</label>
						if f.Type == "textarea" {
							<textarea
								id={ "contact-" + f.Name }
								name={ f.Name }
								class="form-textarea"
								rows="6"
								if f.Placeholder != "" { placeholder={ f.Placeholder } }
								if f.Required { required }
							></textarea>
						} else if f.Type == "select" {
							<select
								id={ "contact-" + f.Name }
								name={ f.Name }
								class="form-select"
								if f.Required { required }
							>
								if f.Placeholder != "" {
									<option value="" disabled selected>{ f.Placeholder }</option>
								}
								for _, opt := range f.Options {
									<option value={ opt }>{ opt }</option>
								}
							</select>
						} else {
							<input
								type={ fieldInputType(f.Type) }
								id={ "contact-" + f.Name }
								name={ f.Name }
								class="form-input"
								if f.Placeholder != "" { placeholder={ f.Placeholder } }
								if f.Required { required }
								if f.Type == "email" { autocomplete="email" }
								if f.Name == "name" { autocomplete="name" }
							/>
						}
					</div>
				}

				<div class="form-actions">
					<button type="submit" class="form-submit" id="contact-submit">
						{ texts.SubmitText }
					</button>
				</div>
			</form>
		</div>
	</section>
}
