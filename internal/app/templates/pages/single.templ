package pages

import "github.com/layer87-labs/webhull/internal/app/templates"

// SinglePage renders a complete one-page site.
//
// The entire site lives at / and is one scrollable HTML document.
//
// Two content modes are supported:
//
// 1. Typed sections (recommended):
//    Define content with typed section markers in the HTML file body:
//      <!-- section[type,altbg,id=anchor]: Title -->
//    Supported types: "block", "grid", "services".
//    When typed sections are present, a contact form is appended at #contact
//    automatically if contact.enabled=true in the site config.
//
// 2. Raw body fallback:
//    When no typed section markers are found, the entire body HTML is rendered
//    as-is. Use this when the content file contains fully custom HTML that
//    manages its own structure and contact section.
//
// Hero is rendered from frontmatter keys when any hero key is present
// (heroTitle, heroLine1, heroSubtitle, heroCTA1Text, heroCTA2Text).
// If no hero keys are set the hero section is skipped entirely.
templ SinglePage(data *templates.PageData) {
	@templates.Layout(data) {
		// Hero — only rendered when at least one hero key is set in frontmatter.
		if data.HasContent("heroTitle") || data.HasContent("heroLine1") || data.HasContent("heroSubtitle") || data.HasContent("heroCTA1Text") {
			<section class="hero">
				<div class="container">
					<div class="hero-content">
						<h1 class="hero-title">
							if data.HasContent("heroTitle") {
								{ data.Content("heroTitle") }
							} else {
								{ data.Content("heroLine1") }
								if data.HasContent("heroLine2") {
									<br/>
									<span class="gradient-text">{ data.Content("heroLine2") }</span>
								}
							}
						</h1>
						if data.HasContent("heroSubtitle") {
							<p class="hero-subtitle">{ data.Content("heroSubtitle") }</p>
						}
						if data.HasContent("heroDescription") {
							<p class="hero-description">{ data.Content("heroDescription") }</p>
						}
						<div class="hero-cta">
							if data.HasContent("heroCTA1Text") {
								<a href={ templ.SafeURL(data.Content("heroCTA1Link")) } class="btn btn-gradient">
									{ data.Content("heroCTA1Text") }
								</a>
							}
							if data.HasContent("heroCTA2Text") {
								<a href={ templ.SafeURL(data.Content("heroCTA2Link")) } class="btn btn-outline">
									{ data.Content("heroCTA2Text") }
								</a>
							}
						</div>
					</div>
				</div>
				<div class="hero-bg-gradient"></div>
			</section>
		}
		// Typed sections mode: render each section in declaration order,
		// then append the webhull contact form at #contact if enabled.
		if len(data.Page.Sections) > 0 {
			for _, s := range data.Page.Sections {
				<section class={ sectionClass(s.Type, s.AltBg) } { sectionIDAttr(s.ID)... }>
					<div class="container">
						if s.Title != "" {
							<div class="section-header">
								<h2 class="section-title">
									@templ.Raw(s.Title)
								</h2>
							</div>
						}
						<div class={ sectionInnerClass(s.Type) }>
							@templ.Raw(s.Body)
						</div>
					</div>
				</section>
			}
			if data.ContactEnabled {
				<section class="content-section alt-bg" id="contact">
					<div class="container">
						@templates.ContactForm(data.ResolveContactTexts())
					</div>
				</section>
			}
		} else if data.HasContent("body") {
			// Raw body fallback: the content file manages its own structure
			// including any contact section. Nothing extra is appended.
			@templ.Raw(data.Content("body"))
		}
	}
}
