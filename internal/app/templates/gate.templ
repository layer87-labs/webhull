package templates

// GatePage renders a standalone access gate page.
// It has no layout wrapper (no header, footer, nav) — purely a logo + code input form.
// The ?redirect query parameter is threaded through as a hidden form field so the
// user lands at their intended destination after a successful login.
templ GatePage(data *GatePageData) {
	<!DOCTYPE html>
	<html lang="de">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ data.SiteName }</title>
		<meta name="robots" content="noindex, nofollow"/>
		<style>
			*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

			html, body {
				width: 100vw; height: 100vh;
				background: #000;
				color: #e8eefc;
				font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
				overflow: hidden;
				-webkit-font-smoothing: antialiased;
			}

			body::after {
				content: '';
				position: fixed; inset: 0;
				z-index: 200;
				pointer-events: none;
				background: repeating-linear-gradient(
					0deg,
					transparent, transparent 2px,
					rgba(0,0,0,0.04) 2px, rgba(0,0,0,0.04) 4px
				);
			}

			#bg {
				position: fixed; inset: 0; z-index: 0;
				opacity: 0; transition: opacity 4s ease;
			}
			#bg.show { opacity: 1; }

			#vortex {
				position: fixed; inset: 0; z-index: 50;
				opacity: 0; pointer-events: none;
				transition: opacity 0.2s ease;
			}
			#vortex.show { opacity: 1; }

			#flash {
				position: fixed; inset: 0; z-index: 100;
				background: #fff; opacity: 0; pointer-events: none;
			}

			#main {
				position: relative; z-index: 10;
				height: 100vh;
				display: flex; flex-direction: column;
				align-items: center; justify-content: center;
				transform-origin: center center;
				transition:
					transform 2.4s cubic-bezier(0.55, 0, 1, 1),
					opacity   1.8s ease,
					filter    2.2s ease;
			}
			#main.sucked {
				transform: scale(0.001);
				opacity: 0;
				filter: blur(30px);
			}

			@keyframes glitch {
				0%, 100% { transform: translate(0) skew(0deg); }
				10%  { transform: translate(-4px,  2px) skew(-1deg); }
				20%  { transform: translate( 4px, -2px) skew( 1deg); }
				30%  { transform: translate(-3px,  0px) skew( 0.5deg); }
				40%  { transform: translate( 3px,  2px) skew(-0.5deg); }
				50%  { transform: translate(-2px, -1px) skew( 0deg); }
				60%  { transform: translate( 2px,  0px) skew( 0.3deg); }
				75%  { transform: translate(-1px,  1px) skew(-0.2deg); }
			}
			#main.glitch { animation: glitch 0.55s ease; }

			@keyframes deny-pulse {
				0%,100% { box-shadow: inset 0 0 0 rgba(255,113,108,0); }
				40%     { box-shadow: inset 0 0 120px rgba(255,113,108,0.06); }
			}
			body.deny { animation: deny-pulse 0.7s ease; }

			.ca {
				position: fixed; width: 44px; height: 44px;
				z-index: 5; opacity: 0;
				transition: opacity 2.5s ease;
			}
			.ca.show { opacity: 1; }
			#ca-tl { top: 22px; left: 22px;  border-top:    1px solid rgba(129,236,255,.18); border-left:   1px solid rgba(129,236,255,.18); }
			#ca-tr { top: 22px; right:22px;  border-top:    1px solid rgba(129,236,255,.18); border-right:  1px solid rgba(129,236,255,.18); }
			#ca-bl { bottom:22px; left:22px; border-bottom: 1px solid rgba(129,236,255,.18); border-left:   1px solid rgba(129,236,255,.18); }
			#ca-br { bottom:22px; right:22px;border-bottom: 1px solid rgba(129,236,255,.18); border-right:  1px solid rgba(129,236,255,.18); }

			.reveal { opacity: 0; transition: opacity 1.3s ease; }
			.reveal.show { opacity: 1; }

			#logo {
				font-size: clamp(0.8rem, 2.2vw, 1.05rem);
				font-weight: 600;
				letter-spacing: 0.75em;
				color: #81ecff;
				text-transform: uppercase;
				text-shadow: 0 0 24px rgba(129,236,255,.45);
				margin-bottom: 2.8rem;
				user-select: none;
			}

			#tagline {
				font-size: clamp(0.5rem, 1.2vw, 0.6rem);
				font-weight: 400;
				letter-spacing: 0.5em;
				text-transform: uppercase;
				color: rgba(165,171,184,.45);
				margin-bottom: 3rem;
			}

			#terminal { width: min(380px, 88vw); }

			.t-label {
				font-size: 0.55rem;
				letter-spacing: 0.4em;
				text-transform: uppercase;
				color: rgba(129,236,255,.5);
				margin-bottom: 0.65rem;
			}

			.t-box {
				display: flex; align-items: center; gap: 0.5rem;
				border: 1px solid rgba(129,236,255,.12);
				background: rgba(8,15,24,.92);
				padding: 1rem 1.25rem;
				position: relative;
				transition: border-color 0.25s ease, box-shadow 0.25s ease;
			}
			.t-box::before {
				content: '';
				position: absolute; top: 0; left: 10%; right: 10%; height: 1px;
				background: linear-gradient(90deg, transparent, rgba(129,236,255,.22), transparent);
			}
			.t-box.err {
				border-color: rgba(255,113,108,.55);
				box-shadow: 0 0 20px rgba(255,113,108,.12);
			}
			.t-box.ok {
				border-color: rgba(82,214,138,.55);
				box-shadow: 0 0 30px rgba(82,214,138,.18);
			}

			.t-prompt { color: #81ecff; font-size: 1rem; flex-shrink: 0; }

			#pw {
				flex: 1;
				background: none; border: none; outline: none;
				color: #e8eefc;
				font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
				font-size: 1rem; letter-spacing: 0.15em;
				caret-color: #81ecff;
			}

			.t-cursor {
				width: 2px; height: 1.15em;
				background: #81ecff; flex-shrink: 0;
				animation: blink 1s step-end infinite;
			}
			@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

			#msg {
				margin-top: 1rem; min-height: 1.2rem;
				font-size: 0.57rem; letter-spacing: 0.35em;
				text-transform: uppercase; text-align: center;
				opacity: 0; transition: opacity 0.3s;
			}
			#msg.show { opacity: 1; }
			#msg.err  { color: #ff716c; }
			#msg.ok   { color: #52d68a; }

			#meta {
				position: fixed; bottom: 20px; left: 0; right: 0;
				display: flex; justify-content: center; gap: clamp(1rem, 4vw, 3rem);
				font-size: 0.5rem; letter-spacing: 0.25em;
				text-transform: uppercase; color: rgba(165,171,184,.2);
				z-index: 10; opacity: 0; transition: opacity 3s ease;
				flex-wrap: wrap;
			}
			#meta.show { opacity: 1; }
		</style>
	</head>
	<body>
		if data.Error {
			<meta id="_gate_error" content="1" hidden/>
		}
		<div class="ca" id="ca-tl"></div>
		<div class="ca" id="ca-tr"></div>
		<div class="ca" id="ca-bl"></div>
		<div class="ca" id="ca-br"></div>

		<canvas id="bg"></canvas>
		<canvas id="vortex"></canvas>
		<div id="flash"></div>

		<div id="meta">
			<span>ARCON v4.0</span>
			<span>QUANTUM-AES-256</span>
			<span id="clock">--:--:--</span>
			<span>&#9632; AWAITING HANDSHAKE</span>
		</div>

		<div id="main">
			<div id="logo" class="reveal">ARCON</div>
			<div id="tagline" class="reveal">Clearance Required</div>
			<div id="terminal" class="reveal">
				<div class="t-label">Access Code</div>
				<div class="t-box" id="tbox">
					<span class="t-prompt">&#62;&nbsp;</span>
					<form id="gate-form" method="POST" action={ templ.SafeURL(data.FormAction) } style="display:contents">
						if data.Redirect != "" {
							<input type="hidden" name="redirect" value={ data.Redirect }/>
						}
						<input
							id="pw"
							type="password"
							name="code"
							autocomplete="off"
							spellcheck="false"
							autocorrect="off"
							autocapitalize="off"
						/>
					</form>
					<div class="t-cursor"></div>
				</div>
				<div id="msg"></div>
			</div>
		</div>

		<script>
		(function () {
			var serverError = !!document.getElementById('_gate_error');
			var locked = false;

			var clockEl  = document.getElementById('clock');
			var logo     = document.getElementById('logo');
			var tagline  = document.getElementById('tagline');
			var terminal = document.getElementById('terminal');
			var meta     = document.getElementById('meta');
			var corners  = ['ca-tl','ca-tr','ca-bl','ca-br'].map(function(id){ return document.getElementById(id); });
			var pwEl     = document.getElementById('pw');
			var tbox     = document.getElementById('tbox');
			var msgEl    = document.getElementById('msg');
			var main     = document.getElementById('main');
			var flash    = document.getElementById('flash');
			var form     = document.getElementById('gate-form');

			function tick() { clockEl.textContent = new Date().toTimeString().slice(0, 8); }
			tick(); setInterval(tick, 1000);

			setTimeout(function(){ logo.classList.add('show'); corners.forEach(function(c){ c.classList.add('show'); }); }, 700);
			setTimeout(function(){ tagline.classList.add('show'); }, 1400);
			setTimeout(function(){ terminal.classList.add('show'); meta.classList.add('show'); pwEl.focus(); }, 2100);

			/* ── Background starfield ── */
			var bg  = document.getElementById('bg');
			var bgc = bg.getContext('2d');
			var bW, bH, stars = [];

			function resizeBg() { bW = bg.width = window.innerWidth; bH = bg.height = window.innerHeight; }
			resizeBg();
			window.addEventListener('resize', resizeBg);

			for (var i = 0; i < 70; i++) {
				stars.push({ x: Math.random(), y: Math.random(), s: 0.3 + Math.random() * 1.3, a: 0.03 + Math.random() * 0.1, vx: (Math.random() - 0.5) * 0.00008, vy: (Math.random() - 0.5) * 0.00006 });
			}
			var bgAlpha = 0;
			setTimeout(function(){
				var t0 = null;
				(function fadeBg(ts) {
					if (!t0) t0 = ts;
					bgAlpha = Math.min((ts - t0) / 4000, 1);
					if (bgAlpha < 1) requestAnimationFrame(fadeBg);
				})(performance.now());
				bg.classList.add('show');
			}, 400);

			(function drawBg() {
				bgc.clearRect(0, 0, bW, bH);
				stars.forEach(function(s) {
					s.x = (s.x + s.vx + 1) % 1;
					s.y = (s.y + s.vy + 1) % 1;
					bgc.beginPath();
					bgc.arc(s.x * bW, s.y * bH, s.s, 0, Math.PI * 2);
					bgc.fillStyle = 'rgba(129,236,255,' + (s.a * bgAlpha) + ')';
					bgc.fill();
				});
				requestAnimationFrame(drawBg);
			})();

			/* ── Vortex canvas ── */
			var vc  = document.getElementById('vortex');
			var vcc = vc.getContext('2d');
			var vParts = [], vRunning = false, vStart = 0;

			function initVortex() {
				vc.width = window.innerWidth; vc.height = window.innerHeight;
				var cx = vc.width / 2, cy = vc.height / 2;
				vParts = [];
				for (var j = 0; j < 320; j++) {
					var angle = Math.random() * Math.PI * 2;
					var r = 80 + Math.random() * Math.max(cx, cy) * 1.5;
					vParts.push({ x: cx + Math.cos(angle) * r, y: cy + Math.sin(angle) * r, s: 0.5 + Math.random() * 2, a: 0.25 + Math.random() * 0.5, sp: 0.4 + Math.random() * 0.9 });
				}
			}

			function drawVortex(ts) {
				if (!vRunning) return;
				var prog = Math.min((ts - vStart) / 2600, 1);
				var cx = vc.width / 2, cy = vc.height / 2;
				vcc.clearRect(0, 0, vc.width, vc.height);
				var gr = vcc.createRadialGradient(cx, cy, 0, cx, cy, Math.max(cx, cy) * (1.3 - prog * 0.5));
				gr.addColorStop(0, 'rgba(0,0,0,' + (0.55 + prog * 0.4) + ')');
				gr.addColorStop(1, 'rgba(0,0,0,' + (prog * 0.35) + ')');
				vcc.fillStyle = gr;
				vcc.fillRect(0, 0, vc.width, vc.height);
				vParts.forEach(function(p) {
					var dx = cx - p.x, dy = cy - p.y;
					var dist = Math.hypot(dx, dy);
					var angle = Math.atan2(dy, dx);
					var pull = (1 + prog * 11) * p.sp;
					var spin = (2 + prog *  5) * p.sp;
					p.x += Math.cos(angle) * pull + Math.cos(angle + Math.PI * 0.5) * spin;
					p.y += Math.sin(angle) * pull + Math.sin(angle + Math.PI * 0.5) * spin;
					if (dist < 8) {
						var na = Math.random() * Math.PI * 2;
						var nr = 160 + Math.random() * 500;
						p.x = cx + Math.cos(na) * nr; p.y = cy + Math.sin(na) * nr;
					}
					var alpha = p.a * (1 - prog * 0.15);
					vcc.beginPath();
					vcc.arc(p.x, p.y, Math.max(0.2, p.s), 0, Math.PI * 2);
					vcc.fillStyle = dist < 130 ? 'rgba(129,236,255,' + alpha + ')' : 'rgba(200,220,255,' + (alpha * 0.6) + ')';
					vcc.fill();
				});
				if (prog > 0.4) {
					var rp = (prog - 0.4) / 0.6;
					vcc.beginPath();
					vcc.arc(cx, cy, Math.max(1, 28 * (1 - rp)), 0, Math.PI * 2);
					vcc.strokeStyle = 'rgba(129,236,255,' + (rp * 0.85) + ')';
					vcc.lineWidth = 1.5;
					vcc.stroke();
				}
				if (prog < 1) {
					requestAnimationFrame(drawVortex);
				} else {
					flash.style.transition = 'opacity 0.28s ease';
					flash.style.opacity = '1';
					setTimeout(function(){ form.submit(); }, 280);
				}
			}

			function spawnRings() {
				var cx = window.innerWidth / 2, cy = window.innerHeight / 2;
				[180, 320, 460, 600].forEach(function(size, i) {
					setTimeout(function() {
						var ring = document.createElement('div');
						Object.assign(ring.style, { position: 'fixed', borderRadius: '50%', border: '1px solid rgba(129,236,255,0.55)', width: size + 'px', height: size + 'px', left: (cx - size / 2) + 'px', top: (cy - size / 2) + 'px', pointerEvents: 'none', zIndex: '40', opacity: '0', transform: 'scale(0.1)', transition: 'transform 0.55s ease-out, opacity 0.55s ease-out' });
						document.body.appendChild(ring);
						requestAnimationFrame(function() {
							ring.style.transform = 'scale(1)'; ring.style.opacity = '0.55';
							setTimeout(function() { ring.style.opacity = '0'; setTimeout(function(){ ring.remove(); }, 600); }, 280);
						});
					}, i * 90);
				});
			}

			function setMsg(text, type) { msgEl.textContent = text; msgEl.className = 'show ' + type; }
			function clearMsg() { msgEl.className = ''; msgEl.textContent = ''; }

			function doLogin() {
				if (locked) return;
				locked = true;
				pwEl.readOnly = true;
				tbox.classList.add('ok');
				setMsg('CLEARANCE GRANTED — INITIATING SEQUENCE', 'ok');
				setTimeout(spawnRings, 900);
				setTimeout(function() {
					main.classList.add('sucked');
					vc.classList.add('show');
					vRunning = true;
					initVortex();
					vStart = performance.now();
					requestAnimationFrame(drawVortex);
				}, 1350);
			}

			function showDeny() {
				document.body.classList.add('deny');
				tbox.classList.add('err');
				main.classList.add('glitch');
				setMsg('ACCESS DENIED — THE VOID DOES NOT FORGET', 'err');
				setTimeout(function() {
					document.body.classList.remove('deny');
					tbox.classList.remove('err');
					main.classList.remove('glitch');
					clearMsg();
					locked = false;
					pwEl.readOnly = false;
					pwEl.focus();
				}, 3200);
			}

			if (serverError) {
				locked = true;
				setTimeout(showDeny, 2300);
			}

			pwEl.addEventListener('keydown', function(e) {
				if (e.key === 'Enter') { e.preventDefault(); doLogin(); }
			});
		})();
		</script>
	</body>
	</html>
}
