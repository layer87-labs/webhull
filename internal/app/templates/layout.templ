package templates

// Layout renders the full HTML page with head, body, header, content, footer, and consent banner.
templ Layout(data *PageData) {
	<!DOCTYPE html>
	<html lang={ data.LangCode() }>
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ data.Meta.Title }</title>
		if data.Meta.Description != "" {
			<meta name="description" content={ data.Meta.Description }/>
		}
		if data.Meta.Keywords != "" {
			<meta name="keywords" content={ data.Meta.Keywords }/>
		}
		if data.Meta.NoIndex {
			<meta name="robots" content="noindex, nofollow"/>
		}
		if data.Meta.CanonicalURL != "" {
			<link rel="canonical" href={ data.Meta.CanonicalURL }/>
		}
		for _, hl := range data.Meta.Hreflang {
			<link rel="alternate" hreflang={ hl.Lang } href={ hl.Href }/>
		}
		if data.Meta.OGTitle != "" {
			<meta property="og:title" content={ data.Meta.OGTitle }/>
		}
		if data.Meta.OGDescription != "" {
			<meta property="og:description" content={ data.Meta.OGDescription }/>
		}
		if data.Meta.OGImage != "" {
			<meta property="og:image" content={ data.Meta.OGImage }/>
		}
		if data.Meta.OGType != "" {
			<meta property="og:type" content={ data.Meta.OGType }/>
		}
		if data.Meta.OGUrl != "" {
			<meta property="og:url" content={ data.Meta.OGUrl }/>
		}
		<meta property="og:site_name" content={ data.Site.Name }/>
		if data.Meta.TwitterCard != "" {
			<meta name="twitter:card" content={ data.Meta.TwitterCard }/>
		}
		if data.Meta.Author != "" {
			<meta name="author" content={ data.Meta.Author }/>
		}
		for _, ld := range data.Meta.JSONLD {
			@templ.Raw(`<script type="application/ld+json">` + ld + `</script>`)
		}
		if data.Site.FaviconPath != "" {
			<link rel="icon" type="image/webp" href={ data.Site.FaviconPath }/>
		}
		<link rel="stylesheet" href={ data.AssetPath("/static/css/webhull.css") }/>
		<link rel="stylesheet" href={ data.AssetPath("/static/css/style.css") }/>
		<script src={ data.AssetPath("/static/js/theme-init.js") }></script>
		// Client-side analytics is injected only with accepted analytics consent.
		// The Plausible script sends a pageview as soon as it loads, so emitting
		// it before a decision would track the visitor regardless of their choice.
		if data.Analytics.PlausibleEnabled && data.ClientAnalyticsAllowed() {
			<script defer data-domain={ data.Analytics.PlausibleDomain } data-api="/api/event" src="/js/script.js"></script>
		}
		// Error tracking is NOT behind analytics consent, unlike Plausible.
		// The two do different things: Plausible observes the visitor, this
		// observes the software. It is configured to send no IP address, no
		// cookies and no request headers, so it collects nothing about the
		// person — and a channel that only fires with consent would miss
		// exactly the visitors whose browser broke before the banner loaded.
		if data.ErrorTracking.Enabled {
			<script src={ data.ErrorTracking.SDKURL } crossorigin="anonymous"></script>
			<script
				src={ data.AssetPath("/static/js/errortracking-init.js") }
				data-dsn={ data.ErrorTracking.DSN }
				data-environment={ data.ErrorTracking.Environment }
				data-release={ data.ErrorTracking.Release }
				data-sample-rate={ data.ErrorTracking.SampleRate }
			></script>
		}
	</head>
	<body>
		@Header(data)
		{ children... }
		@Footer(data)
		// The banner markup is also emitted after a decision — hidden — so the
		// decision stays withdrawable from any page.
		if data.RenderConsentBanner() {
			@ConsentBanner(data.ConsentConfig, data.LangCode(), data.ConsentDecided())
		}
		<script defer src={ data.AssetPath("/static/js/menu.js") }></script>
		if data.Page != nil && (data.Page.Template == "contact" || data.Page.Template == "single") {
			<script defer src={ data.AssetPath("/static/js/contact.js") }></script>
		}
		if data.Analytics.CollectorEnabled && data.ClientAnalyticsAllowed() {
			<script defer src={ data.AssetPath("/static/js/analytics.js") }></script>
		}
		// consent.js is suppressed for automated audit tools (bypass mode).
		if data.ConsentConfig != nil && data.ConsentConfig.Enabled && !data.ConsentBypassed() {
			<script defer src={ data.AssetPath("/static/js/consent.js") }></script>
		}
	</body>
	</html>
}
