package templates

import (
	"fmt"
	"time"
)

// InstagramFeed renders a responsive Instagram post grid.
// Posts are server-rendered with lazy-loaded images (<img loading="lazy">),
// captions, timestamps, and links to the original Instagram post.
// VIDEO posts get a play overlay icon. CAROUSEL_ALBUM posts show the first child image.
//
// Usage in page templates:
//
//	if data.InstagramFeed != nil {
//	    @templates.InstagramFeed(data.InstagramFeed)
//	}
templ InstagramFeed(data *InstagramFeedData) {
	if data == nil || len(data.Posts) == 0 {
		return
	}
	<section class="instagram-feed">
		<div class="container">
			<div class="instagram-feed-header">
				<h2 class="instagram-feed-heading">
					{ "Instagram" }
						if data.Username != "" {
							<span class="instagram-feed-username">
								<a href={ templ.SafeURL(data.ProfileURL) } target="_blank" rel="noopener noreferrer">
										{ "@" + data.Username }
								</a>
							</span>
						}
				</h2>
			</div>
			<div class="instagram-grid">
				for _, post := range data.Posts {
					<div class="instagram-card">
						<a href={ templ.SafeURL(post.Permalink) } target="_blank" rel="noopener noreferrer" class="instagram-card-link">
							<div class="instagram-card-image-wrapper">
								if post.MediaURL != "" {
									<img
										src={ templ.SafeURL(post.MediaURL) }
										alt={ truncateCaption(post.Caption, 120) }
										loading="lazy"
										class="instagram-card-image"
									/>
								}
								if post.MediaType == "VIDEO" || post.MediaType == "IGTV" {
									<div class="instagram-card-play-overlay">
										<svg viewBox="0 0 24 24" fill="white" width="48" height="48" aria-hidden="true">
											<path d="M8 5v14l11-7z"/>
										</svg>
									</div>
								}
								if post.MediaType == "CAROUSEL_ALBUM" {
									<div class="instagram-card-carousel-icon">
										<svg viewBox="0 0 24 24" fill="white" width="20" height="20" aria-hidden="true">
											<path d="M22 3H7c-.69 0-1.23.35-1.59.88L0 12l5.41 8.11c.36.53.9.89 1.59.89h15c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-3 12.59L17.59 17 14 13.41 10.41 17 9 15.59 12.59 12 9 8.41 10.41 7 14 10.59 17.59 7 19 8.41 15.41 12 19 15.59z"/>
										</svg>
									</div>
								}
							</div>
							<div class="instagram-card-text">
								if post.Caption != "" {
									<p class="instagram-card-caption">{ truncateCaption(post.Caption, 150) }</p>
								}
								<div class="instagram-card-meta">
									<time class="instagram-card-date" datetime={ post.Timestamp.Format(time.RFC3339) }>
										{ formatRelativeDate(post.Timestamp) }
									</time>
									if data.ShowEngagement {
										<div class="instagram-card-engagement">
											if post.LikeCount > 0 {
												<span class="instagram-card-likes">
													<svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true">
														<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
													</svg>
													{ fmt.Sprintf("%d", post.LikeCount) }
												</span>
											}
											if post.CommentsCount > 0 {
												<span class="instagram-card-comments">
													<svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true">
														<path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/>
													</svg>
													{ fmt.Sprintf("%d", post.CommentsCount) }
												</span>
											}
										</div>
									}
								</div>
							</div>
						</a>
					</div>
				}
			</div>
		</div>
	</section>
}

// truncateCaption shortens a caption to maxLen runes, appending "…" when truncated.
func truncateCaption(s string, maxLen int) string {
	if s == "" {
		return ""
	}
	runes := []rune(s)
	if len(runes) <= maxLen {
		return s
	}
	return string(runes[:maxLen-1]) + "…"
}

// formatRelativeDate returns a human-readable relative date string.
// Examples: "2 days ago", "3 weeks ago", "1 month ago".
func formatRelativeDate(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		m := int(d.Minutes())
		if m == 1 {
			return "1 minute ago"
		}
		return fmt.Sprintf("%d minutes ago", m)
	case d < 24*time.Hour:
		h := int(d.Hours())
		if h == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", h)
	case d < 7*24*time.Hour:
		days := int(d.Hours() / 24)
		if days == 1 {
			return "1 day ago"
		}
		return fmt.Sprintf("%d days ago", days)
	case d < 30*24*time.Hour:
		weeks := int(d.Hours() / (24 * 7))
		if weeks == 1 {
			return "1 week ago"
		}
		return fmt.Sprintf("%d weeks ago", weeks)
	case d < 365*24*time.Hour:
		months := int(d.Hours() / (24 * 30))
		if months == 1 {
			return "1 month ago"
		}
		return fmt.Sprintf("%d months ago", months)
	default:
		years := int(d.Hours() / (24 * 365))
		if years == 1 {
			return "1 year ago"
		}
		return fmt.Sprintf("%d years ago", years)
	}
}
